  object ZQueryKunjungan: TZQuery
    Connection = DataModuleKoneksi.ZConnectionSimrsERM
    SQL.Strings = (
      'SELECT'
      '    rp.no_rawat,'
      '    rp.tgl_registrasi,'
      '    rp.jam_reg,'
      '    rp.no_rkm_medis,'
      '    ps.nm_pasien,'
      '    rp.status_lanjut,'
      '    rp.stts,'
      '    rp.status_bayar,'
      ''
      '    -- Poli (untuk Rajal)'
      '    pl.nm_poli,'
      ''
      '    -- Dokter'
      '    dk.nm_dokter,'
      ''
      '    -- Ranap: kamar & bangsal'
      '    bg.nm_bangsal,'
      '    kmr.kd_kamar,'
      '    kmr.kelas'
      'FROM reg_periksa rp'
      'LEFT JOIN pasien ps '
      '    ON rp.no_rkm_medis = ps.no_rkm_medis'
      'LEFT JOIN poliklinik pl '
      '    ON rp.kd_poli = pl.kd_poli'
      'LEFT JOIN dokter dk '
      '    ON rp.kd_dokter = dk.kd_dokter'
      ''
      '-- JOIN khusus RAWAT INAP'
      'LEFT JOIN kamar_inap ki '
      '    ON rp.no_rawat = ki.no_rawat'
      'LEFT JOIN kamar kmr '
      '    ON ki.kd_kamar = kmr.kd_kamar'
      'LEFT JOIN bangsal bg '
      '    ON kmr.kd_bangsal = bg.kd_bangsal'
      ''
      'WHERE rp.status_lanjut IN (''Ralan'',''Ranap'') '
      ''
      'ORDER BY '
      '    rp.tgl_registrasi DESC,'
      '    rp.jam_reg DESC,'
      '    rp.no_rawat DESC'
    )
    Params = <>
    Left = 674
    Top = 56
  end
  object DataSourceKunjungan: TDataSource
    DataSet = ZQueryKunjungan
    Left = 768
    Top = 64
  end
  object ZQueryTriase: TZQuery
    Connection = DataModuleKoneksi.ZConnectionSimrsERM
    SQL.Strings = (
      'SELECT'
      '  dt.no_rawat,'
      '  dt.tgl_kunjungan,'
      '  dt.cara_masuk,'
      '  dt.alat_transportasi,'
      '  dt.alasan_kedatangan,'
      '  dt.keterangan_kedatangan,'
      '  dt.tekanan_darah,'
      '  dt.nadi,'
      '  dt.pernapasan,'
      '  dt.suhu,'
      '  dt.saturasi_o2,'
      '  dt.nyeri,'
      '  mk.macam_kasus'
      'FROM data_triase_igd dt'
      'LEFT JOIN master_triase_macam_kasus mk'
      '  ON dt.kode_kasus = mk.kode_kasus'
      'WHERE dt.no_rawat = :no_rawat;'
    )
    Params = <    
      item
        Name = 'no_rawat'
      end>
    Left = 670
    Top = 140
    ParamData = <    
      item
        Name = 'no_rawat'
      end>
  end
