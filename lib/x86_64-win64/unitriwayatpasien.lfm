  object ZQueryPenilaianIGD: TZQuery
    Connection = DataModuleKoneksi.ZConnectionSimrsERM
    Active = True
    SQL.Strings = (
      'SELECT'
      '  p.no_rawat,'
      '  p.tanggal,'
      '  p.informasi,'
      '  p.keluhan_utama,'
      '  p.rpd,'
      '  p.rpo,'
      '  p.status_kehamilan,'
      '  p.gravida,'
      '  p.para,'
      '  p.abortus,'
      '  p.hpht,'
      ''
      '  p.tekanan,'
      '  p.pupil,'
      '  p.neurosensorik,'
      '  p.integumen,'
      '  p.turgor,'
      '  p.edema,'
      '  p.mukosa,'
      '  p.perdarahan,'
      '  p.jumlah_perdarahan,'
      '  p.warna_perdarahan,'
      '  p.intoksikasi,'
      ''
      '  p.psikologis,'
      '  p.jiwa,'
      '  p.perilaku,'
      ''
      '  p.nyeri,'
      '  p.provokes,'
      '  p.ket_provokes,'
      '  p.quality,'
      '  p.ket_quality,'
      '  p.lokasi,'
      '  p.menyebar,'
      '  p.skala_nyeri,'
      '  p.durasi,'
      '  p.nyeri_hilang,'
      ''
      '  p.hasil,'
      '  p.rencana,'
      '  pg.nama AS perawat'
      'FROM penilaian_awal_keperawatan_igd p'
      'LEFT JOIN petugas pg ON p.nip = pg.nip'
      'WHERE p.no_rawat = :no_rawat;'
    )
    Params = <    
      item
        Name = 'no_rawat'
      end>
    Left = 667
    Top = 416
    ParamData = <    
